# --- Go ---
/bin/
/dist/
*.exe
*.test
*.out
coverage.*
vendor/

# --- Godot (test project) ---
# Per-machine cache, import data, and the addon's runtime discovery file.
project/.godot/
*.import
.godot/

# --- Editor / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Agent/framework runtime state — machine-local, not project config.
.claude/scheduled_tasks.lock

# transient study checkouts (see the reference-slot section in CLAUDE.md)
reference/

# Source captures and encode masters for the preview media. The stills in
# media/previews/ are committed and serve the README and the Asset Library
# listing; the video itself is uploaded to YouTube, because that is the only
# video form the Asset Library takes and a clone should not carry 80 MB of it.
media/previews/*.mp4

# Per-run eval state (the target project's porcelain baseline, machine summaries).
# Ledgers under evals/results/ are committed; this is scratch for one run.
evals/.runstate/

# Redirected editor stdout/stderr. An agent launches the editor with its stdio
# sent here (a plain launch corrupts the terminal's rendering), so these pile up
# per session and are diagnostic only.
editor_session/

# Machine-local MCP client config (absolute paths; differs per machine)
.mcp.json
