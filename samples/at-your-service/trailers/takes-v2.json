  "help": {
    "argv": [
      "node",
      "set",
      "--help"
    ],
    "output": "swallowtail node set: Set node properties. Two forms: singular --property + --value, OR a batch --properties object; the batch validates all names up front and writes atomically in one undo action.\n\nParams:\n  --node-path   NodePath    required  Target node.\n  --property    String      optional  Property name (singular form; pair with --value). Omit when using --properties.\n  --value       JSON        optional  Value for --property (scalar, Godot literal string, or JSON), coerced toward the property's type; an @export node-path property resolves a path to the node. Required with --property.\n  --properties  Dictionary  optional  Batch form: {property: value}, written atomically. Use instead of --property/--value.",
    "exit": 0
  },
