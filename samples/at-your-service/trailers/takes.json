  "agent_help": {
    "argv": [
      "shader",
      "set-param",
      "--help"
    ],
    "command": "swallowtail shader set-param --help",
    "output": "swallowtail shader set_param: Set a uniform on a node's ShaderMaterial. A string --value is evaluated as an Expression (so 'Vector3(1,0,0)', numbers, etc. work).\n\nParams:\n  --node-path  NodePath  required  Node with a ShaderMaterial.\n  --param      String    required  Uniform name.\n  --value      JSON      optional  Value to set (string is Expression-evaluated; may be null/omitted).",
    "stderr": "",
    "exit": 0
  },
