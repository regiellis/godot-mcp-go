# Go files are LF everywhere: gofmt writes LF, and with core.autocrlf alone the
# working tree flapped between the two on every task check (gofmt -l listed every
# file forever). Release artifacts are unaffected: both release scripts already
# force autocrlf off for git archive.
*.go text eol=lf

# Downloadable reports retain their exact PDF bytes.
*.pdf binary

# Static source and copy-page payloads have stable newlines on every platform.
website/site/**/*.html text eol=lf
website/site/**/*.css text eol=lf
website/site/**/*.js text eol=lf
website/site/**/*.txt text eol=lf
website/site/index.html text eol=lf
website/site/llm.txt text eol=lf
