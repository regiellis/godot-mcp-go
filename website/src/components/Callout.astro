---
import { withBase } from "../lib/paths";

interface Props {
  type?: "note" | "tip" | "important" | "warning" | "caution";
  title?: string;
}
const { type = "note", title } = Astro.props;

---

<aside class="callout" data-type={type} role="note">
  <span class="callout-mascot" aria-hidden="true"><img src={withBase(`/brand/callouts/${type}.webp`)} width={152} height={152} alt="" loading="lazy" decoding="async" /></span>
  <div class="callout-body">
    <div class="callout-kind">{type}</div>
    {title && <div class="callout-title">{title}</div>}
    <slot />
  </div>
</aside>
