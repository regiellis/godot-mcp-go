---
import { docsHref } from "../lib/paths";
const KEY = "swallowtail-announcement-rename";
---

<div class="announce" id="announce" role="region" aria-label="Announcement" data-key={KEY}>
  <div class="announce-inner">
    <p><strong>godot-mcp is now Swallowtail.</strong> Same toolkit, new name. <a href={`${docsHref("migration")}#why-the-name-changed`}>Why, and how to migrate</a></p>
    <button class="announce-dismiss" type="button" aria-label="Dismiss announcement" title="Dismiss">&times;</button>
  </div>
</div>
<script is:inline>
  (function () {
    var el = document.getElementById("announce");
    if (!el) return;
    var key = el.getAttribute("data-key");
    try { if (localStorage.getItem(key) === "1") el.hidden = true; } catch (e) {}
    var btn = el.querySelector(".announce-dismiss");
    if (btn) btn.addEventListener("click", function () {
      el.hidden = true;
      try { localStorage.setItem(key, "1"); } catch (e) {}
    });
  })();
</script>

<style>
  .announce {
    background: var(--accent-soft);
    color: var(--text);
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .announce-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem var(--site-gutter);
    max-width: var(--site-max-width);
    margin: 0 auto;
  }
  .announce p { margin: 0; flex: 1; min-width: 0; }
  .announce strong { font-weight: 650; }
  .announce a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .announce a:hover { color: var(--accent-strong); }
  .announce-dismiss {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    font: 400 1.15rem/1 var(--font-sans);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .announce-dismiss:hover { color: var(--text); border-color: var(--border-strong); }
  .announce-dismiss:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
