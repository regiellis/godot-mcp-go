---
import { withBase } from "../lib/paths";
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<a class="logo" href={withBase("/")} aria-label="Swallowtail home">
  <img src={withBase("/brand/swallowtail-butler.png")} width="40" height="40" alt="" />
  {!compact && <span>Swallowtail</span>}
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--text); }
  .logo:hover { text-decoration: none; }
  .logo img { object-fit: contain; }
  .logo span { font: 750 1.1rem var(--font-display); letter-spacing: -0.035em; }
</style>
